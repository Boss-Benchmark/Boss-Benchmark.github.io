---
interface Props {
  stats: { value: string; label: string; sub?: string; tone?: Tone }[];
}

type Tone = "place" | "amber" | "move" | "open";

const { stats } = Astro.props;

// The original project page gave each headline number its own colour; keeping
// that, mapped onto the theme's skill palette.
const tones: Record<Tone, string> = {
  place: "var(--skill-place)",
  amber: "var(--accent-amber)",
  move: "var(--skill-move)",
  open: "var(--skill-open)",
};
---

<dl
  class="not-prose my-12 grid grid-cols-1 gap-x-10 gap-y-8 sm:grid-cols-2"
>
  {
    stats.map((stat) => (
      <div
        class="border-l-2 pl-4"
        style={`border-color: ${stat.tone ? tones[stat.tone] : "var(--primary)"}`}
      >
        <dd
          class="m-0 text-3xl font-semibold tracking-tight tabular-nums"
          style={`color: ${stat.tone ? tones[stat.tone] : "var(--primary)"}`}
        >
          {stat.value}
        </dd>
        <dt class="text-foreground mt-1 text-sm leading-snug">{stat.label}</dt>
        {stat.sub && (
          <p class="text-muted-foreground m-0 mt-0.5 text-xs">{stat.sub}</p>
        )}
      </div>
    ))
  }
</dl>
