---
import { Picture as AstroPicture } from "astro:assets";
import { renderPDF } from "../lib/render-pdf";

interface Props {
  src: ImageMetadata | `${string}.pdf`;
  alt: string;
  priority?: boolean;
  invertInDarkMode?: boolean;
  sizes?: string;
  /** Cap the rendered height in px. Figures with very different aspect ratios
   *  otherwise render at wildly different heights once width-constrained. */
  maxHeight?: number;
}

const {
  src,
  alt,
  priority = false,
  invertInDarkMode = false,
  sizes = "(min-width: 46rem) 40rem, 100vw",
  maxHeight,
} = Astro.props;

let image: ImageMetadata;

if (typeof src === "string") {
  image = await renderPDF(src);
} else {
  image = src;
}
---

<AstroPicture
  class={`rounded-lg max-h-[calc(100svh-3rem)] max-w-full w-min mx-auto ${invertInDarkMode ? "dark:invert" : ""}`}
  style={maxHeight ? `max-height:${maxHeight}px;width:auto` : undefined}
  src={image}
  alt={alt}
  layout="constrained"
  formats={["avif", "webp"]}
  fallbackFormat="webp"
  sizes={sizes}
  priority={priority}
  fit="contain"
/>
