---
interface Props {
  /** How wide the image may run. "text" is exactly the prose measure, "wide"
   *  lets a long strip run a little past it, "narrow" pulls a small figure in.
   *  Each cap is 3rem over the image width because the inner div carries px-6;
   *  the caption reuses the same cap so it is always as wide as the image. */
  size?: "narrow" | "text" | "wide";
}

const { size = "text" } = Astro.props;

const widthCap = {
  narrow: "max-w-[38rem]",
  text: "max-w-[47rem]",
  wide: "max-w-[59rem]",
}[size];
---

<figure class="full-bleed my-12">
  <div
    class:list={[
      "mx-auto flex w-full justify-start overflow-x-auto px-6 **:my-0 [&_img]:min-w-[36rem] sm:[&_img]:min-w-0 sm:justify-center",
      widthCap,
    ]}
  >
    <slot name="figure" />
  </div>
  <figcaption
    class:list={[
      "text-muted-foreground mx-auto mt-4 px-6 text-left text-[0.9375rem] leading-[1.6]",
      widthCap,
    ]}
  >
    <slot name="caption" />
  </figcaption>
</figure>
